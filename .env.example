# WhatsApp Business API Configuration
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Slack Events API Configuration
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Telegram Bot API Configuration
TELEGRAM_SECRET_TOKEN=your_telegram_secret_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Configuration
# Example: postgres://username:password@hostname:5432/dbname?sslmode=disable
DATABASE_URL=

# Google Cloud Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id_here
VERTEX_AI_LOCATION=us-west2
VERTEX_AI_MODEL=gemini-2.0-flash

# Koko AI source trust policy configuration
# strict mode constrains external context to allowlisted domains only
KOKO_SOURCE_TRUST_STRICT=true
# comma-separated domain allowlist for external context
KOKO_SOURCE_TRUST_ALLOWLIST=en.wikipedia.org,data.worldbank.org,api.worldbank.org
# per-source confidence weighting (source=weight, comma-separated)
KOKO_SOURCE_TRUST_WEIGHTS=internal=1.0,wikipedia=0.8,worldbank=0.95

# Feature Runtime Configuration
# Options: all | industrial | electronics | revenue | consumer
KOKO_FEATURE_MODE=all

# Downstream action endpoints used by koko:act
INDUSTRIAL_ACTION_ENDPOINT=
ELECTRONICS_ACTION_ENDPOINT=
REVENUE_ACTION_ENDPOINT=
CONSUMER_ACTION_ENDPOINT=

# Server Configuration
PORT=8080